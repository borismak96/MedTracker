    "Terms & Conditions" : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "條款與細則"
          }
        }
      }
    },
    "Terms_Body_1" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This app is strictly a personal health tracking tool. It does not provide professional medical diagnoses or advice. Always consult a healthcare professional for medical concerns."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本應用程式僅作為個人健康記錄與追蹤工具，不提供任何專業的醫療診斷或建議。若您有任何醫療疑問，請務必諮詢專業醫師。"
          }
        }
      }
    },
    "Terms_Body_2" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We value your privacy. All your health data is stored locally on your device and your personal iCloud account. We do not collect, sell, or share your sensitive health data with third parties."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我們非常重視您的隱私。您輸入的所有健康數據與個人資料均僅儲存於您的設備及個人的 iCloud 帳號中。我們不會收集、出售或與第三方分享您的任何敏感健康資料。"
          }
        }
      }
    },
    "Terms_Body_3" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The developers are not liable for any health issues or consequences arising from the use of this app."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本應用程式開發團隊不對因使用本程式所記錄之數據或產生的任何健康狀況負擔法律責任。"
          }
        }
      }
    },
    "Terms_Body_4" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We reserve the right to modify these terms at any time. Updates will be reflected within the app."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我們保留隨時修改本條款與細則的權利，更新後將於應用程式內公告。"
          }
        }
      }
    },
    "Terms_Body_5" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All information and medication records entered in this app are strictly for your own personal reference."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本應用程式內記錄的所有資訊與藥物資料僅供您個人參考使用。"
          }
        }
      }
    },
    "Terms_Content" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welcome to PillPal.\n\n1. Nature of Service\nThis app is strictly a personal health tracking tool. It does not provide professional medical diagnoses or advice. Always consult a healthcare professional for medical concerns.\n\n2. Privacy\nWe value your privacy. All your health data is stored locally on your device and your personal iCloud account. We do not collect, sell, or share your sensitive health data with third parties.\n\n3. Disclaimer\nThe developers are not liable for any health issues or consequences arising from the use of this app.\n\n4. Changes to Terms\nWe reserve the right to modify these terms at any time. Updates will be reflected within the app.\n\n5. Information for Reference Only\nAll information and medication records entered in this app are strictly for your own personal reference."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歡迎使用藥伴伴。\n\n1. 服務性質\n本應用程式僅作為個人健康記錄與追蹤工具，不提供任何專業的醫療診斷或建議。若您有任何醫療疑問，請務必諮詢專業醫師。\n\n2. 隱私權保護\n我們非常重視您的隱私。您輸入的所有健康數據與個人資料均僅儲存於您的設備及個人的 iCloud 帳號中。我們不會收集、出售或與第三方分享您的任何敏感健康資料。\n\n3. 免責聲明\n本應用程式開發團隊不對因使用本程式所記錄之數據或產生的任何健康狀況負擔法律責任。\n\n4. 條款修改\n我們保留隨時修改本條款與細則的權利，更新後將於應用程式內公告。\n\n5. 資訊僅供參考\n本應用程式內記錄的所有資訊與藥物資料僅供您個人參考使用。"
          }
        }
      }
    },
    "Terms_Title_1" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Nature of Service"
          }
        },
