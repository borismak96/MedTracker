    "About_Us_Content" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PillPal is designed to help you easily track your daily medications and health data. It's a simple, intuitive, and privacy-respecting tool to make managing your health easier.\n\nThank you for using our app!"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "藥伴伴旨在幫助您輕鬆記錄日常服藥情況與健康數據。這是一個簡單、直觀且尊重隱私的追蹤工具，讓您的健康管理更加輕鬆。\n\n感謝您的使用與支持！"
          }
        }
      }
